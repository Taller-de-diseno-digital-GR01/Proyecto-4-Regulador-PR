clockInfo.txt

__pycache__/
*.pyc

sw/.venv/

#archivos lock de PDFs
.~lock.*#

# Intermedios del ensamblado (sw/ensamblar.sh). El .hex de la ROM si se versiona.
sw/build/

# El Block Design exportado y el script que crea el proyecto sí se versionan
!src/bd/*.tcl
!src/crear_proyecto.tcl
!src/programar_vitis.tcl

# Proyecto de Vivado y workspace de Vitis, se regeneran desde src/bd y sw
vivado/
vitis/
*.str

# Salidas de simulación de LTspice, se regeneran desde el .asc
*.raw
*.net

# Volcados VCD de los testbenches, se regeneran con make sim TB=<nombre> +VCD
*.vcd

