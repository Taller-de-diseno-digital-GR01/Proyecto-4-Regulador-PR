*.aux
*.bbl
*.bcf
*.blg
*.out
*.run.xml
*.thm
*.synctex.gz

# Proyecto de Vivado local fuera de vivado/
project_4_PR/

# Mapa de memoria que genera Vivado al implementar
*.mmi
# Formas de onda que escribe potencia/sim/lazo_cerrado.py, unos 5 MB cada una, se regeneran con el script
potencia/sim/lazo_cerrado_*.csv
!src/sim_temporizada.tcl
!docs/informe/evidencia/*.log
!sim/**/*.log

